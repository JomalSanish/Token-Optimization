{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /models Response Schema",
  "description": "Returns active model catalog and pricing required by the frontend client.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["provider", "model_id", "display_name", "pricing", "context_window", "capabilities"],
    "properties": {
      "provider": { "type": "string", "enum": ["openai", "google", "anthropic"] },
      "model_id": { "type": "string" },
      "display_name": { "type": "string" },
      "pricing": {
        "type": "object",
        "required": ["input_per_1m", "output_per_1m", "cached_input_per_1m", "batch_input_per_1m", "batch_output_per_1m"],
        "properties": {
          "input_per_1m": { "type": "number", "minimum": 0 },
          "output_per_1m": { "type": "number", "minimum": 0 },
          "cached_input_per_1m": { "type": "number", "minimum": 0 },
          "batch_input_per_1m": { "type": "number", "minimum": 0 },
          "batch_output_per_1m": { "type": "number", "minimum": 0 }
        }
      },
      "context_window": { "type": "integer", "minimum": 1 },
      "capabilities": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
