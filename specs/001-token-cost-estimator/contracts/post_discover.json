{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "POST /discover-optimizations API Contract",
  "description": "JSON schema for the /discover-optimizations endpoint requests and responses.",
  "type": "object",
  "required": ["request", "response"],
  "properties": {
    "request": {
      "type": "object",
      "required": [
        "project_description", "document_summaries", "phases",
        "pricing_snapshot", "estimate_result", "optimize_result", "active_rules"
      ],
      "properties": {
        "project_description": { "type": "string" },
        "document_summaries": {
          "type": "array",
          "items": { "type": "object" }
        },
        "phases": {
          "type": "array",
          "items": { "type": "object" }
        },
        "pricing_snapshot": { "type": "object" },
        "estimate_result": { "type": "object" },
        "optimize_result": { "type": "object" },
        "active_rules": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "response": {
      "type": "object",
      "required": ["ai_strategies", "unquantified_opportunities"],
      "properties": {
        "ai_strategies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "strategy_id", "name", "category", "affected_phases", "affected_token_pool",
              "description", "rationale", "mechanism", "estimated_savings", "confidence",
              "assumptions", "evidence", "implementation_effort", "risk", "dependencies",
              "overlap_with_existing_rules", "included_in_official_savings"
            ],
            "properties": {
              "strategy_id": { "type": "string" },
              "name": { "type": "string" },
              "category": { "type": "string" },
              "affected_phases": {
                "type": "array",
                "items": { "type": "string" }
              },
              "affected_token_pool": { "type": "string", "enum": ["input", "output", "both"] },
              "description": { "type": "string" },
              "rationale": { "type": "string" },
              "mechanism": { "type": "string" },
              "estimated_savings": {
                "type": "object",
                "required": ["low_percent", "expected_percent", "high_percent"],
                "properties": {
                  "low_percent": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                  "expected_percent": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                  "high_percent": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
                }
              },
              "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
              "assumptions": {
                "type": "array",
                "items": { "type": "string" }
              },
              "evidence": {
                "type": "array",
                "items": { "type": "string" }
              },
              "implementation_effort": { "type": "string", "enum": ["low", "medium", "high"] },
              "risk": { "type": "string" },
              "dependencies": {
                "type": "array",
                "items": { "type": "string" }
              },
              "overlap_with_existing_rules": { "type": "string" },
              "included_in_official_savings": { "type": "boolean", "const": false }
            }
          }
        },
        "unquantified_opportunities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description", "rationale"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
